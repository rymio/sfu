# Example systemd unit for the sfu `chat` example binary.
#
# See ../DEPLOY.md for full setup (rustup toolchain, certs at /cert/cert.pem+key.pem,
# ufw rules, DNS). Edit <PUBLIC_IP> below to this host's actual public IP before
# installing — on a multi-interface VPS, leaving --host at its default (127.0.0.1,
# which triggers auto-selection of "some" non-loopback address) can pick the wrong
# interface; being explicit avoids that ambiguity.
#
# SFU_JOIN_SECRET / SFU_TURN_SECRET are read from EnvironmentFile below, not written
# inline here, so they don't end up in a world-readable unit file
# (`/etc/systemd/system/*.service` is typically mode 644). Create the env file first:
#   sudo mkdir -p /etc/sfu
#   sudo tee /etc/sfu/chat.env >/dev/null <<'EOF'
#   SFU_JOIN_SECRET=<openssl rand -base64 32>
#   SFU_TURN_SECRET=<must match turn1.sigs.au's static-auth-secret>
#   EOF
#   sudo chmod 600 /etc/sfu/chat.env
#   sudo chown sfu:sfu /etc/sfu/chat.env
#
#   sudo cp deploy/sfu-chat.service /etc/systemd/system/sfu-chat.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sfu-chat

[Unit]
Description=sigs.au SFU (webrtc-rs/sfu fork, chat example binary)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sfu
Group=sfu
WorkingDirectory=/home/sfu/sfu
EnvironmentFile=/etc/sfu/chat.env
ExecStart=/home/sfu/sfu/target/release/examples/chat --host <PUBLIC_IP> --signal-port 443 --media-port-min 3478 --media-port-max 3495 --tls --level info
Restart=always
RestartSec=5

# --signal-port 443 is a privileged port; grant just the one capability needed to bind
# it instead of running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
